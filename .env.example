# CyberHawk RE — Environment Configuration
# Copy to .env and adjust before running docker compose up

# Ghidra JVM heap size — increase for large/complex binaries
# Default: -Xmx4g (4GB). Increase to -Xmx8g for binaries > 100MB
# JAVA_OPTS=-Xmx4g -XX:+UseG1GC

# Override MCP bridge port (default 8081)
# MCP_BRIDGE_PORT=8081

# Override internal Ghidra headless server port (default 8089, never exposed externally)
# GHIDRA_MCP_PORT=8089
